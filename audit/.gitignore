# ======================
# audit – minimal ignore
# Mac + Python + shell
# ======================

# ---- runtime output (core audit artifacts) ----
baseline/
archives/
current/
report/
state/
*.log
*.out
*.diff
*.snapshot
*.tmp

# packet captures / net work
*.pcap
*.pcapng

# ---- Python ----
__pycache__/
*.pyc
*.pyo
*.pyd

# virtualenv (if you ever use one)
.venv/
venv/

# ---- macOS filesystem noise ----
.DS_Store
._*
.Spotlight-V100
.Trashes
.fseventsd
__MACOSX/

# ---- editor noise ----
.vscode/
.idea/
*.swp
*.swo
*~

# ---- keep the real project ----
!collectors/
!pymaudit/
!scripts/
!*.sh
!*.py
!README.md
