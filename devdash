#!/usr/bin/env bash
# @desc: Show the dev component and command inventory dashboard
# @tags: dev dashboard inventory
# @run: user

set -euo pipefail

ROOT="${HOME}/dev"
SCAN="${ROOT}/component-scan.sh"

: "${TERM:=xterm-256color}"
tp() { tput "$@" 2>/dev/null || true; }

BOLD="$(tp bold)"
DIM="$(tp dim)"
RESET="$(tp sgr0)"
HDR="$(tp setaf 6)"
ACCENT="$(tp setaf 2)"
MUTED="$(tp setaf 7)"
WARN="$(tp setaf 3)"

if [[ ! -f "$SCAN" ]]; then
  echo "error: component scanner not found: $SCAN" >&2
  exit 1
fi

clear
printf "%sDEV DASHBOARD%s\n" "$BOLD" "$RESET"
printf "%sInventory-first component view of %s%s\n\n" "${DIM:-}" "$ROOT" "$RESET"

TMP="$(mktemp -t devdash.XXXXXX)"
i=1
current_component=""
current_group=""

while IFS=$'\t' read -r kind source path component group name run tags alias desc; do
  [[ "$kind" == "cmd" ]] || continue

  if [[ "$component" != "$current_component" ]]; then
    printf "\n%s%s%s\n" "$BOLD$HDR" "$component" "$RESET"
    current_component="$component"
    current_group=""
  fi

  if [[ "$group" != "$current_group" ]]; then
    printf "%s  %s%s%s\n" "${DIM:-}" "${ACCENT:-}" "$group" "$RESET"
    current_group="$group"
  fi

  [[ "$alias" == "-" ]] && alias=""
  display_name="${alias:-$name}"
  printf "%s%2d%s  %-18s  %s%-5s%s  %s\n" \
    "$BOLD" "$i" "$RESET" \
    "$display_name" \
    "${MUTED:-}" "$run" "$RESET" \
    "$desc"
  printf "%s     %s[%s] %s%s\n" "${DIM:-}" "${MUTED:-}" "$source" "$path" "$RESET"
  printf "%s|%s|%s\n" "$i" "$ROOT/$path" "$run" >> "$TMP"
  i=$((i + 1))
done < <(python3 "$SCAN" "$ROOT" records)

printf "\n%sSelect number to run (Enter = quit)%s\n" "${DIM:-}" "$RESET"
read -r choice

if [[ -z "${choice:-}" ]]; then
  rm -f "$TMP"
  exit 0
fi

entry="$(grep -E "^${choice}\|" "$TMP" || true)"
rm -f "$TMP"

if [[ -z "$entry" ]]; then
  printf "%sInvalid selection.%s\n" "${WARN:-}" "$RESET"
  exit 1
fi

cmd="$(printf "%s" "$entry" | cut -d'|' -f2)"
runmode="$(printf "%s" "$entry" | cut -d'|' -f3)"

printf "\n%s→ Running %s%s\n\n" "$BOLD" "$(basename "$cmd")" "$RESET"

if [[ "$runmode" == "sudo" ]]; then
  sudo "$cmd"
else
  "$cmd"
fi
