#!/usr/bin/env bash
# dev-cmd: alias=devdash name=Devdash group=sys run=user legend=hide desc="Show the dev component and command inventory dashboard"

set -euo pipefail

ROOT="${HOME}/dev"
SCAN="${ROOT}/component-scan.sh"

: "${TERM:=xterm-256color}"
tp() { tput "$@" 2>/dev/null || true; }

BOLD="$(printf '\033[1m')"
DIM="$(printf '\033[2m')"
RESET="$(printf '\033[0m')"
HDR="$(printf '\033[38;5;110m')"
ACCENT="$(printf '\033[38;5;109m')"
MUTED="$(printf '\033[38;5;244m')"
WARN="$(printf '\033[38;5;179m')"

if [[ ! -f "$SCAN" ]]; then
  echo "error: component scanner not found: $SCAN" >&2
  exit 1
fi

clear
printf "%sDEV DASHBOARD%s\n" "$BOLD" "$RESET"
printf "%sInventory-first component view of %s%s\n\n" "${DIM:-}" "$ROOT" "$RESET"

TMP="$(mktemp -t devdash.XXXXXX)"
i=1
current_component=""

while IFS=$'\t' read -r source path source_path component group alias name run desc; do
  [[ -n "$source" ]] || continue

  if [[ "$component" != "$current_component" ]]; then
    printf "\n%s%s%s\n" "$BOLD$HDR" "$component" "$RESET"
    current_component="$component"
  fi

  [[ "$alias" == "-" ]] && alias=""
  [[ "$name" == "-" ]] && name=""
  display_name="${alias:-$name}"
  printf "%s%2d%s  %-18s  %s%-5s%s  %s%s\n" \
    "$BOLD" "$i" "$RESET" \
    "$display_name" \
    "${MUTED:-}" "$run" "$RESET" \
    "$desc" \
    ""
  if [[ -n "$name" && "${name,,}" != "${display_name,,}" ]]; then
    printf "%s     %s[%s] %s (%s)%s\n" "${DIM:-}" "${MUTED:-}" "$source" "$path" "$name" "$RESET"
  else
    printf "%s     %s[%s] %s%s\n" "${DIM:-}" "${MUTED:-}" "$source" "$path" "$RESET"
  fi
  printf "%s|%s|%s|%s|%s\n" "$i" "$source" "$ROOT/$source_path" "$run" "$display_name" >> "$TMP"
  i=$((i + 1))
done < <(
  python3 "$SCAN" "$ROOT" index | python3 -c '
import json, sys

payload = json.load(sys.stdin)
for cmd in payload.get("commands", []):
    if cmd.get("source") == "shell":
        continue
    row = [
        cmd.get("source", ""),
        cmd.get("path", ""),
        cmd.get("source_path", ""),
        cmd.get("component", ""),
        cmd.get("group", ""),
        cmd.get("alias", ""),
        cmd.get("name", ""),
        cmd.get("run", "user"),
        cmd.get("desc", ""),
    ]
    print("\t".join(row))
'
)

printf "\n%sSelect number to run (Enter = quit)%s\n" "${DIM:-}" "$RESET"
read -r choice

if [[ -z "${choice:-}" ]]; then
  rm -f "$TMP"
  exit 0
fi

entry="$(grep -E "^${choice}\|" "$TMP" || true)"
rm -f "$TMP"

if [[ -z "$entry" ]]; then
  printf "%sInvalid selection.%s\n" "${WARN:-}" "$RESET"
  exit 1
fi

source_kind="$(printf "%s" "$entry" | cut -d'|' -f2)"
cmd_path="$(printf "%s" "$entry" | cut -d'|' -f3)"
runmode="$(printf "%s" "$entry" | cut -d'|' -f4)"
shell_cmd="$(printf "%s" "$entry" | cut -d'|' -f5)"

printf "\n%s→ Running %s%s\n\n" "$BOLD" "${shell_cmd:-$(basename "$cmd_path")}" "$RESET"

if [[ "$source_kind" == "shell" ]]; then
  if [[ "$runmode" == "sudo" ]]; then
    sudo zsh -lic "$shell_cmd"
  else
    zsh -lic "$shell_cmd"
  fi
elif [[ "$runmode" == "sudo" ]]; then
  sudo "$cmd_path"
else
  "$cmd_path"
fi
