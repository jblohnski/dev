#!/usr/bin/env bash
# dev-cmd: alias=devdash name=Devdash group=sys run=user legend=hide desc="Show the dev component and command inventory dashboard"

set -euo pipefail

ROOT="${DEV_ROOT:-$HOME/dev}"
SCAN="${ROOT}/component-scan.sh"

: "${TERM:=xterm-256color}"

BOLD="$(printf '\033[1m')"
DIM="$(printf '\033[2m')"
RESET="$(printf '\033[0m')"
HDR="$(printf '\033[38;5;110m')"
MUTED="$(printf '\033[38;5;244m')"
WARN="$(printf '\033[38;5;179m')"

if [[ ! -f "$SCAN" ]]; then
  echo "error: component scanner not found: $SCAN" >&2
  exit 1
fi

clear
printf "%sDEV DASHBOARD%s\n" "$BOLD" "$RESET"
printf "%sInventory-first command view of %s%s\n\n" "${DIM:-}" "$ROOT" "$RESET"

TMP="$(mktemp -t devdash.XXXXXX)"
RUN_TMP="$(mktemp -t devdash.run.XXXXXX)"
MANIFEST_TMP="$(mktemp -t devdash.manifest.XXXXXX)"
cleanup() {
  rm -f "$TMP" "$RUN_TMP" "$MANIFEST_TMP"
}
trap cleanup EXIT

python3 "$SCAN" "$ROOT" manifest > "$MANIFEST_TMP"
python3 - "$MANIFEST_TMP" > "$TMP" <<'PY'
import json
import sys

manifest_path = sys.argv[1]

with open(manifest_path, encoding="utf-8") as handle:
    items = json.load(handle).get("items", [])

group_order = {"sys": 0, "audit": 1, "net": 2}
selected = []
for item in items:
    if item.get("record_type") != "cmd":
        continue
    if not item.get("legend_visible"):
        continue
    alias = item.get("alias") or item.get("cmd") or ""
    path = item.get("path") or ""
    if not alias or not path:
        continue
    selected.append(
        (
            item.get("display_order"),
            item.get("group", ""),
            alias,
            item.get("name", "") or alias,
            item.get("desc", ""),
            item.get("run", "user") or "user",
            item.get("source", ""),
            path,
        )
    )

selected.sort(key=lambda row: (row[0] is None, row[0] or 0, group_order.get(row[1], 99), row[2]))

for row in selected:
    print("\t".join("" if value is None else str(value) for value in row))
PY

i=1
current_group=""

while IFS=$'\t' read -r display_order group alias name desc run source cmd_path; do
  [[ -n "$alias" ]] || continue

  if [[ "$group" != "$current_group" ]]; then
    group_label="$(printf "%s" "$group" | tr '[:lower:]' '[:upper:]')"
    printf "\n%s%s%s\n" "$BOLD$HDR" "$group_label" "$RESET"
    current_group="$group"
  fi

  printf "%s%2d%s  %-18s  %s%s\n" \
    "$BOLD" "$i" "$RESET" \
    "$alias" \
    "$desc" \
    ""
  name_fold="$(printf "%s" "$name" | tr '[:upper:]' '[:lower:]')"
  alias_fold="$(printf "%s" "$alias" | tr '[:upper:]' '[:lower:]')"
  if [[ -n "$name" && "$name_fold" != "$alias_fold" ]]; then
    printf "%s     %s%s%s\n" "${DIM:-}" "${MUTED:-}" "$name" "$RESET"
  fi
  printf "%s|%s|%s|%s|%s\n" "$i" "$ROOT/$cmd_path" "$run" "$alias" "$source" >> "$RUN_TMP"
  i=$((i + 1))
done < "$TMP"

printf "\n%sSelect number to run (Enter = quit)%s\n" "${DIM:-}" "$RESET"
read -r choice

if [[ -z "${choice:-}" ]]; then
  exit 0
fi

entry="$(grep -E "^${choice}\|" "$RUN_TMP" || true)"

if [[ -z "$entry" ]]; then
  printf "%sInvalid selection.%s\n" "${WARN:-}" "$RESET"
  exit 1
fi

cmd_path="$(printf "%s" "$entry" | cut -d'|' -f2)"
runmode="$(printf "%s" "$entry" | cut -d'|' -f3)"
shell_cmd="$(printf "%s" "$entry" | cut -d'|' -f4)"
source_kind="$(printf "%s" "$entry" | cut -d'|' -f5)"

printf "\n%s→ Running %s%s\n\n" "$BOLD" "${shell_cmd:-$(basename "$cmd_path")}" "$RESET"

if [[ "$shell_cmd" =~ ^[A-Za-z0-9_.-]+$ ]]; then
  if DEV_ROOT="$ROOT" DEV_DASH_CMD="$shell_cmd" zsh -ic '
    source "$DEV_ROOT/bootstrap/shell/dev.sh" >/dev/null 2>&1 || exit 1
    if whence -w "$DEV_DASH_CMD" >/dev/null 2>&1; then
      eval "$DEV_DASH_CMD"
    else
      exit 127
    fi
  '; then
    exit 0
  fi
  status=$?
  if [[ "$status" -ne 127 ]]; then
    exit "$status"
  fi
fi

if [[ "$source_kind" == "shell" ]]; then
  printf "%sCommand is shell-backed and could not be resolved through the dev shell loader.%s\n" "${WARN:-}" "$RESET"
  exit 127
fi

if [[ "$runmode" == "sudo" ]]; then
  sudo "$cmd_path"
else
  "$cmd_path"
fi
