#!/usr/bin/env bash
# dev-cmd: alias=devdash name=Devdash group=sys run=user legend=hide desc="Show the dev component and command inventory dashboard"

set -euo pipefail

ROOT="${HOME}/dev"
SCAN="${ROOT}/component-scan.sh"

: "${TERM:=xterm-256color}"
tp() { tput "$@" 2>/dev/null || true; }

BOLD="$(printf '\033[1m')"
DIM="$(printf '\033[2m')"
RESET="$(printf '\033[0m')"
HDR="$(printf '\033[38;5;110m')"
ACCENT="$(printf '\033[38;5;109m')"
MUTED="$(printf '\033[38;5;244m')"
WARN="$(printf '\033[38;5;179m')"

if [[ ! -f "$SCAN" ]]; then
  echo "error: component scanner not found: $SCAN" >&2
  exit 1
fi

clear
printf "%sDEV DASHBOARD%s\n" "$BOLD" "$RESET"
printf "%sInventory-first command view of %s%s\n\n" "${DIM:-}" "$ROOT" "$RESET"

TMP="$(mktemp -t devdash.XXXXXX)"
INDEX_TMP="$(mktemp -t devdash.index.XXXXXX)"
RECORDS_TMP="$(mktemp -t devdash.records.XXXXXX)"
MERGED_TMP="$(mktemp -t devdash.merge.XXXXXX)"
cleanup() {
  rm -f "$TMP" "$INDEX_TMP" "$RECORDS_TMP" "$MERGED_TMP"
}
trap cleanup EXIT

python3 "$SCAN" "$ROOT" index > "$INDEX_TMP"
python3 "$SCAN" "$ROOT" records > "$RECORDS_TMP"
python3 - "$INDEX_TMP" "$RECORDS_TMP" > "$MERGED_TMP" <<'PY'
import json
import sys

index_path, records_path = sys.argv[1:3]

with open(index_path, encoding="utf-8") as handle:
    commands = json.load(handle).get("commands", [])

runtime: dict[str, tuple[str, str]] = {}
with open(records_path, encoding="utf-8") as handle:
    for raw in handle:
        row = raw.rstrip("\n").split("\t")
        if len(row) != 10 or row[0] != "cmd":
            continue
        _, source, path, _component, _group, _name, alias, run, _keywords, _desc = row
        if source != "script":
            continue
        runtime.setdefault(alias, (path, run or "user"))

group_order = {"sys": 0, "audit": 1, "net": 2}
selected = [cmd for cmd in commands if cmd.get("alias", "") in runtime]
selected.sort(key=lambda cmd: (group_order.get(cmd.get("group", ""), 99), cmd.get("alias", "")))

for cmd in selected:
    path, run = runtime[cmd["alias"]]
    row = [
        cmd.get("group", ""),
        cmd.get("alias", ""),
        cmd.get("name", ""),
        cmd.get("desc", ""),
        run,
        path,
    ]
    print("\t".join(row))
PY

i=1
current_group=""

while IFS=$'\t' read -r group alias name desc run cmd_path; do
  [[ -n "$alias" ]] || continue

  if [[ "$group" != "$current_group" ]]; then
    group_label="$(printf "%s" "$group" | tr '[:lower:]' '[:upper:]')"
    printf "\n%s%s%s\n" "$BOLD$HDR" "$group_label" "$RESET"
    current_group="$group"
  fi

  printf "%s%2d%s  %-18s  %s%s\n" \
    "$BOLD" "$i" "$RESET" \
    "$alias" \
    "$desc" \
    ""
  name_fold="$(printf "%s" "$name" | tr '[:upper:]' '[:lower:]')"
  alias_fold="$(printf "%s" "$alias" | tr '[:upper:]' '[:lower:]')"
  if [[ -n "$name" && "$name_fold" != "$alias_fold" ]]; then
    printf "%s     %s%s%s\n" "${DIM:-}" "${MUTED:-}" "$name" "$RESET"
  fi
  printf "%s|%s|%s|%s\n" "$i" "$ROOT/$cmd_path" "$run" "$alias" >> "$TMP"
  i=$((i + 1))
done < "$MERGED_TMP"

printf "\n%sSelect number to run (Enter = quit)%s\n" "${DIM:-}" "$RESET"
read -r choice

if [[ -z "${choice:-}" ]]; then
  exit 0
fi

entry="$(grep -E "^${choice}\|" "$TMP" || true)"

if [[ -z "$entry" ]]; then
  printf "%sInvalid selection.%s\n" "${WARN:-}" "$RESET"
  exit 1
fi

cmd_path="$(printf "%s" "$entry" | cut -d'|' -f2)"
runmode="$(printf "%s" "$entry" | cut -d'|' -f3)"
shell_cmd="$(printf "%s" "$entry" | cut -d'|' -f4)"

printf "\n%s→ Running %s%s\n\n" "$BOLD" "${shell_cmd:-$(basename "$cmd_path")}" "$RESET"

if [[ "$runmode" == "sudo" ]]; then
  sudo "$cmd_path"
else
  "$cmd_path"
fi
