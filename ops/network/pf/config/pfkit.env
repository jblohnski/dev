# pfkit.env
# Configure, then: sudo pfkit.update

# External interface (optional). Leave empty to auto-detect.
EXT_IF=en0

# DNS policy:
# - router: only default gateway may receive DNS
# - direct: only DNS_ALLOWED may receive DNS
DNS_MODE=direct

# Keep this tight. Quad9 only, unless you explicitly want Cloudflare fallback.
DNS_ALLOWED="9.9.9.9 149.112.112.112"

# RFC1918 LAN ranges
ALLOW_LAN_CIDRS="192.168.1.0/24"

# Intent baseline for this profile.
BASELINE_PROFILE="shell firefox"

# Tight normal-mode egress:
# - TCP is limited to this port set
# - UDP is blocked except DNS plus ALLOW_UDP_PORTS below
ALLOW_TCP_PORTS="22 443"
ALLOW_UDP_PORTS=""
BLOCK_ARBITRARY_UDP=1

# Bonjour / AirDrop / AirPrint / multicast discovery.
# Block it by default: this profile is intentionally hostile to Apple local discovery.
BLOCK_MDNS=1

# Block Apple-managed peer / continuity interfaces by default.
BLOCK_APPLE_P2P=1

# utun* are system-managed tunnels (VPN / NetworkExtension).
# Set to 1 to block them by default and observe the fallout/noise explicitly.
BLOCK_UTUN=0

# Block DNS-over-TLS / DoQ egress on 853
BLOCK_DOT=1

# Block QUIC / HTTP3 so browsers fall back to TCP/443
BLOCK_QUIC=1

# Google endpoint mode:
# - hosts: resolve a tight Google sign-in hostname list at apply time
# - manual: use GOOGLE_ALLOWED IPv4 CIDRs directly
GOOGLE_ENDPOINT_MODE=hosts

# Only used when GOOGLE_ENDPOINT_MODE=manual
GOOGLE_ALLOWED=""

# Used when GOOGLE_ENDPOINT_MODE=hosts.
# Default to sign-in only: account endpoint plus static assets.
GOOGLE_ALLOWED_HOSTS="accounts.google.com ssl.gstatic.com www.gstatic.com"

# Narrow non-Google HTTPS exceptions that still need to work.
# Hostnames are resolved at apply time into /32s.
EXTRA_HTTPS_ALLOWED=""
EXTRA_HTTPS_ALLOWED_HOSTS=""

# Space-delimited IPs and/or CIDRs to block before the normal policy.
# Add the same entry to both lists if you want bidirectional blocking.
BLACKLIST_IN_CIDRS="50.0.0.0/8 68.32.0.0/11 73.0.0.0/8 96.0.0.0/8 98.192.0.0/10"
BLACKLIST_OUT_CIDRS=""
# Back-compat alias
GGC_ALLOWED=""

# IMPORTANT:
# 0 = normal web browsing allowed
# 1 = HTTPS only to Google-owned endpoints (diagnostic / lockdown mode)
#
# Leave Google-only mode off by default; enable it only when you want lockdown mode.
GOOGLE_ONLY_MODE=0
