# pfkit.anchor (hardened - final)

set skip on lo0

table <dns_ok> persist { __DNS_OK__ }
table <lan_nets> persist { __LAN_NETS__ }

# ------------------------------
# DNS enforcement (STRICT + CORRECT)
# ------------------------------

# allow ONLY on primary interface
pass out quick on __EXT_IF__ proto { udp tcp } to <dns_ok> port 53 keep state

# block DNS everywhere else (no interface qualifier)
block return log quick proto { udp tcp } to any port 53

# ------------------------------
# Block DNS-over-TLS (DoT)
# ------------------------------
block return log quick proto tcp to any port 853

# ------------------------------
# Core outbound allow (minimal)
# ------------------------------

# HTTPS / HTTP
pass out quick on __EXT_IF__ proto tcp to any port { 80, 443 } keep state

# NTP (time sync)
pass out quick on __EXT_IF__ proto udp to any port 123 keep state

# ------------------------------
# Enforcement layer
# ------------------------------

# Kill all NetworkExtension tunnels
block drop log quick on utun0
block drop log quick on utun1
block drop log quick on utun2
block drop log quick on utun3

# ------------------------------
# LAN safety
# ------------------------------
pass out quick on __EXT_IF__ to <lan_nets> keep state

# ------------------------------
# Default deny
# ------------------------------
block log all
